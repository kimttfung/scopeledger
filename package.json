{
  "name": "scopeledger",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "dev": "npm run build:paypal && node scripts/prepare-web-env.mjs && npm run dev --workspace @scopeledger/web -- --hostname 127.0.0.1",
    "build": "npm run build:packages && npm run build --workspace @scopeledger/web",
    "build:packages": "tsc --build packages/contracts packages/db packages/domain packages/analysis packages/access packages/adapters/paypal packages/adapters/gemini packages/adapters/email packages/adapters/parser packages/payment-worker",
    "build:protocol": "tsc --build packages/contracts packages/db packages/domain",
    "build:analysis": "tsc --build packages/analysis",
    "build:paypal": "tsc --build packages/contracts packages/adapters/paypal",
    "build:gemini": "tsc --build packages/analysis packages/adapters/gemini",
    "build:email": "tsc --build packages/adapters/email",
    "build:parser": "tsc --build packages/adapters/parser",
    "build:access": "tsc --build packages/access",
    "build:payment-worker": "tsc --build packages/contracts packages/db packages/domain packages/adapters/paypal packages/payment-worker",
    "lint": "npm run lint --workspace @scopeledger/web",
    "typecheck": "npm run build:packages && npm run typecheck:web && tsc --project tsconfig.spikes.json",
    "typecheck:web": "npm run typecheck --workspace @scopeledger/web && tsc --project tsconfig.tests.json",
    "test:ui": "playwright test",
    "test:runtime": "node --test tests/runtime/ip01-runtime.test.mjs",
    "test:ip02-runtime": "node --test tests/runtime/ip02-runtime.test.mjs",
    "test:dev-db-runtime": "node --test tests/runtime/dev-db-runtime.test.mjs",
    "check:ip01-runtime": "node scripts/run-ip01.mjs --check-runtime",
    "check:paypal-config": "npm run build:paypal && node --env-file=.env.local scripts/check-paypal-config.mjs",
    "check:paypal-auth": "npm run build:paypal && node --env-file=.env.local scripts/check-paypal-auth.mjs",
    "check:gemini-config": "npm run build:gemini && node --env-file=.env.local scripts/check-gemini-config.mjs",
    "check:gemini-auth": "npm run build:gemini && node --env-file=.env.local scripts/check-gemini-auth.mjs",
    "check:auth0-config": "node --env-file=.env.local scripts/check-auth0-config.mjs",
    "mailpit:start": "node scripts/run-mailpit.mjs start",
    "mailpit:status": "node scripts/run-mailpit.mjs status",
    "mailpit:stop": "node scripts/run-mailpit.mjs stop",
    "email:demo": "npm run build:email && node --env-file=.env.local scripts/send-mailpit-demo.mjs",
    "prepare:auth0-secret": "node scripts/prepare-auth0-secret.mjs --replace-invalid",
    "prepare:access-secret": "node scripts/prepare-access-secret.mjs --replace-invalid",
    "prepare:dev-db": "node scripts/prepare-dev-db.mjs --replace-invalid",
    "dev:db:start": "node --env-file=.env.local scripts/run-dev-db.mjs start",
    "dev:db:status": "node --env-file=.env.local scripts/run-dev-db.mjs status",
    "dev:db:stop": "node --env-file=.env.local scripts/run-dev-db.mjs stop",
    "dev:db:migrate": "npm run build:protocol && node --env-file=.env.local scripts/migrate-dev-db.mjs",
    "seed:demo": "npm run build:protocol && node --env-file=.env.local scripts/seed-demo.mjs",
    "gemini:synthetic": "npm run build:gemini && node --env-file=.env.local scripts/run-gemini-synthetic.mjs",
    "gemini:scorecard": "npm run build:gemini && node --env-file=.env.local scripts/run-gemini-scorecard.mjs",
    "analysis:golden": "npm run build:packages && node --env-file=.env.local scripts/run-analysis-golden.mjs",
    "paypal:sandbox:create": "npm run build:paypal && node --env-file=.env.local scripts/paypal-sandbox-order.mjs create",
    "paypal:sandbox:capture": "npm run build:paypal && node --env-file=.env.local scripts/paypal-sandbox-order.mjs capture",
    "ip02:create": "npm run build:payment-worker && node --env-file=.env.local scripts/run-ip02.mjs create",
    "ip02:capture": "npm run build:payment-worker && node --env-file=.env.local scripts/run-ip02.mjs capture",
    "ip02:status": "npm run build:payment-worker && node --env-file=.env.local scripts/run-ip02.mjs status",
    "ip02:cleanup": "node scripts/run-ip02.mjs cleanup",
    "test:ip01": "npm run build:protocol && node scripts/run-ip01.mjs",
    "test:analysis": "npm run build:analysis && tsx --test tests/spikes/analysis/*.test.ts",
    "test:paypal:local": "npm run build:paypal && tsx --test tests/spikes/paypal/*.test.ts",
    "test:gemini:local": "npm run build:gemini && tsx --test tests/spikes/gemini/*.test.ts",
    "test:auth0:local": "tsx --test tests/spikes/auth0/*.test.ts",
    "test:access:local": "npm run build:access && tsx --test tests/spikes/access/*.test.ts",
    "test:email:local": "npm run build:email && tsx --test tests/spikes/email/*.test.ts",
    "test:parser:local": "npm run build:parser && tsx --test tests/spikes/parser/*.test.ts",
    "test:payment-worker": "npm run build:payment-worker && tsx --test tests/spikes/payment-worker/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
