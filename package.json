{
  "name": "scopeledger",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "dev": "npm run build:paypal && node scripts/prepare-web-env.mjs && npm run dev --workspace @scopeledger/web -- --hostname 127.0.0.1",
    "h1:prepare": "node scripts/h1-local.mjs prepare",
    "h1:start": "node scripts/h1-local.mjs start",
    "h1:status": "node scripts/h1-local.mjs status",
    "h1:doctor": "node scripts/h1-local.mjs doctor",
    "h1:stop": "node scripts/h1-local.mjs stop",
    "h1:acceptance:quick": "node scripts/run-h1-acceptance.mjs --quick",
    "h1:acceptance:full": "node scripts/run-h1-acceptance.mjs --full",
    "build": "npm run build:packages && npm run build --workspace @scopeledger/web",
    "build:packages": "tsc --build packages/contracts packages/db packages/domain packages/analysis packages/access packages/adapters/paypal packages/adapters/gemini packages/adapters/email packages/adapters/parser packages/adapters/object-storage packages/payment-worker packages/records-export packages/notifications",
    "build:protocol": "tsc --build packages/contracts packages/db packages/domain",
    "build:analysis": "tsc --build packages/analysis",
    "build:paypal": "tsc --build packages/contracts packages/adapters/paypal",
    "build:gemini": "tsc --build packages/analysis packages/adapters/gemini",
    "build:email": "tsc --build packages/adapters/email",
    "build:parser": "tsc --build packages/adapters/parser",
    "build:object-storage": "tsc --build packages/adapters/object-storage",
    "build:records-export": "tsc --build packages/records-export",
    "build:notifications": "tsc --build packages/notifications",
    "build:access": "tsc --build packages/access",
    "build:payment-worker": "tsc --build packages/contracts packages/db packages/domain packages/adapters/paypal packages/payment-worker",
    "lint": "npm run lint --workspace @scopeledger/web",
    "typecheck": "npm run build:packages && npm run typecheck:web && tsc --project tsconfig.spikes.json",
    "typecheck:web": "npm run typecheck --workspace @scopeledger/web && tsc --project tsconfig.tests.json",
    "test:ui": "playwright test",
    "test:runtime": "node --test tests/runtime/ip01-runtime.test.mjs",
    "test:ip02-runtime": "node --test tests/runtime/ip02-runtime.test.mjs",
    "test:dev-db-runtime": "node --test tests/runtime/dev-db-runtime.test.mjs",
    "check:ip01-runtime": "node scripts/run-ip01.mjs --check-runtime",
    "check:paypal-config": "npm run build:paypal && node --env-file=.env.local scripts/check-paypal-config.mjs",
    "check:paypal-auth": "npm run build:paypal && node --env-file=.env.local scripts/check-paypal-auth.mjs",
    "check:paypal-webhook": "npm run build:paypal && node --env-file=.env.local scripts/check-paypal-webhook.mjs --tunnel",
    "paypal:webhook:tunnel": "node scripts/run-paypal-webhook-tunnel.mjs --port 3000",
    "paypal:webhook:manage": "npm run build:paypal && node --env-file=.env.local scripts/manage-paypal-sandbox-webhook.mjs",
    "check:gemini-config": "npm run build:gemini && node --env-file=.env.local scripts/check-gemini-config.mjs",
    "check:gemini-auth": "npm run build:gemini && node --env-file=.env.local scripts/check-gemini-auth.mjs",
    "check:auth0-config": "node --env-file=.env.local scripts/check-auth0-config.mjs",
    "mailpit:start": "node scripts/run-mailpit.mjs start",
    "mailpit:status": "node scripts/run-mailpit.mjs status",
    "mailpit:stop": "node scripts/run-mailpit.mjs stop",
    "email:demo": "npm run build:email && node --env-file=.env.local scripts/send-mailpit-demo.mjs",
    "prepare:auth0-secret": "node scripts/prepare-auth0-secret.mjs --replace-invalid",
    "prepare:access-secret": "node scripts/prepare-access-secret.mjs --replace-invalid",
    "prepare:object-storage": "node scripts/prepare-object-storage.mjs",
    "prepare:h1-operations": "node scripts/prepare-h1-operations.mjs",
    "prepare:dev-db": "node scripts/prepare-dev-db.mjs --replace-invalid",
    "dev:db:start": "node --env-file=.env.local scripts/run-dev-db.mjs start",
    "dev:db:status": "node --env-file=.env.local scripts/run-dev-db.mjs status",
    "dev:db:stop": "node --env-file=.env.local scripts/run-dev-db.mjs stop",
    "dev:db:migrate": "npm run build:protocol && node --env-file=.env.local scripts/migrate-dev-db.mjs",
    "seed:demo": "npm run build:protocol && node --env-file=.env.local scripts/seed-demo.mjs",
    "gemini:synthetic": "npm run build:gemini && node --env-file=.env.local scripts/run-gemini-synthetic.mjs",
    "gemini:scorecard": "npm run build:gemini && node --env-file=.env.local scripts/run-gemini-scorecard.mjs",
    "analysis:golden": "npm run build:packages && node --env-file=.env.local scripts/run-analysis-golden.mjs",
    "paypal:sandbox:create": "npm run build:paypal && node --env-file=.env.local scripts/paypal-sandbox-order.mjs create",
    "paypal:sandbox:capture": "npm run build:paypal && node --env-file=.env.local scripts/paypal-sandbox-order.mjs capture",
    "ip02:create": "npm run build:payment-worker && node --env-file=.env.local scripts/run-ip02.mjs create",
    "ip02:capture": "npm run build:payment-worker && node --env-file=.env.local scripts/run-ip02.mjs capture",
    "ip02:status": "npm run build:payment-worker && node --env-file=.env.local scripts/run-ip02.mjs status",
    "ip02:cleanup": "node scripts/run-ip02.mjs cleanup",
    "paypal:webhooks:process": "npm run build:payment-worker && node --env-file=.env.local scripts/process-paypal-webhooks.mjs",
    "paypal:financial-audit": "npm run build:payment-worker && node --env-file=.env.local scripts/audit-paypal-financials.mjs --limit=100",
    "paypal:financial-audit:status": "npm run build:payment-worker && node --env-file=.env.local scripts/audit-paypal-financials.mjs --status --limit=100",
    "notifications:process": "npm run build:notifications && node --env-file=.env.local scripts/process-notifications.mjs",
    "test:ip01": "npm run build:protocol && node scripts/run-ip01.mjs",
    "test:analysis": "npm run build:analysis && tsx --test tests/spikes/analysis/*.test.ts",
    "test:paypal:local": "npm run build:paypal && tsx --test tests/spikes/paypal/*.test.ts",
    "test:gemini:local": "npm run build:gemini && tsx --test tests/spikes/gemini/*.test.ts",
    "test:auth0:local": "tsx --test tests/spikes/auth0/*.test.ts",
    "test:access:local": "npm run build:access && tsx --test tests/spikes/access/*.test.ts",
    "test:client-decision": "tsx --test tests/spikes/client-decision/*.test.ts",
    "test:client-submissions": "tsx --test tests/spikes/client-submissions/*.test.ts",
    "test:custom-payment": "node scripts/run-ip01.mjs --suite=custom-payment",
    "test:correction-reissue": "npm run build:protocol && node scripts/run-ip01.mjs --suite=correction-reissue && tsx --test tests/spikes/correction-reissue/*.test.tsx",
    "test:work-start": "tsx --test tests/spikes/work-start/*.test.ts",
    "test:analysis-ui": "tsx --test tests/spikes/analysis-ui/*.test.ts",
    "test:analysis-persistence": "npm run build:protocol && node scripts/run-ip01.mjs --suite=analysis-persistence",
    "test:h1-authoring-foundation": "npm run build:protocol && node scripts/run-ip01.mjs --suite=h1-authoring-foundation",
    "test:h1-local-ops": "node --test tests/spikes/h1-local-ops/*.test.mjs",
    "test:h1-acceptance": "node --test tests/spikes/h1-acceptance/*.test.mjs",
    "test:publication-foundation": "npm run build:protocol && node scripts/run-ip01.mjs --suite=publication-foundation",
    "test:payment-ui": "tsx --test tests/spikes/payment-ui/*.test.ts",
    "test:payment-recovery": "tsx --test tests/spikes/payment-recovery/*.test.ts",
    "test:payment-exceptions": "npm run build:payment-worker && node scripts/run-ip01.mjs --suite=payment-exceptions && tsx --test tests/spikes/payment-exceptions/*.test.tsx",
    "test:participant-lifecycle": "node scripts/run-ip01.mjs --suite=participant-lifecycle",
    "test:email:local": "npm run build:email && tsx --test tests/spikes/email/*.test.ts",
    "test:evaluator-controls": "node scripts/run-ip01.mjs --suite=evaluator-controls",
    "test:financial-audit": "tsx --test tests/spikes/financial-audit/*.test.ts tests/spikes/financial-audit/*.test.tsx",
    "test:notifications": "npm run build:notifications && node --env-file=.env.local scripts/run-ip01.mjs --suite=notifications",
    "test:parser:local": "npm run build:parser && tsx --test tests/spikes/parser/*.test.ts",
    "test:object-storage": "npm run build:object-storage && tsx --test tests/spikes/object-storage/*.test.ts",
    "test:provider-source-intake": "tsx --test tests/spikes/provider-source-intake/*.test.ts",
    "test:provider-authoring": "tsx --test tests/spikes/provider-authoring/*.test.ts",
    "test:provider-publication": "tsx --test tests/spikes/provider-publication/*.test.ts",
    "test:provider-participants": "node scripts/run-ip01.mjs --suite=provider-participants",
    "test:provider-reconciliation": "npm run build:protocol && node scripts/run-ip01.mjs --suite=provider-reconciliation && tsx --test tests/spikes/provider-reconciliation/*.test.tsx",
    "test:provider-records": "tsx --test tests/spikes/provider-records/*.test.ts tests/spikes/provider-records/*.test.tsx",
    "test:provider-source-analysis": "node scripts/run-ip01.mjs --suite=provider-source-analysis",
    "test:dynamic-client-review": "node --env-file-if-exists=.env.local --import tsx --test tests/spikes/dynamic-client-review/*.test.ts tests/spikes/dynamic-client-review/*.test.tsx",
    "test:client-drafts": "node --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/spikes/client-drafts/*.test.ts tests/spikes/client-drafts/*.test.tsx",
    "test:records-export": "npm run build:records-export && node scripts/run-ip01.mjs --suite=records-export",
    "test:payment-worker": "npm run build:payment-worker && tsx --test tests/spikes/payment-worker/*.test.ts",
    "test:webhook-worker": "npm run build:payment-worker && tsx --test tests/spikes/webhook-worker/*.test.ts",
    "test:webhook-tooling": "node --test tests/spikes/webhook-tooling/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
