# Sandbox only. Do not put live credentials or real customer data in this profile.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_RETURN_URL=http://127.0.0.1:3000/payments/paypal/return
PAYPAL_CANCEL_URL=http://127.0.0.1:3000/payments/paypal/cancel
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_MS=15000
PAYPAL_WEBHOOK_INBOX_DIR=../../.paypal-sandbox/webhooks

# Google Gemini API. Keep the auth key server-side and restrict it to the Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=120000

# Auth0 provider/staff identity. Client approvers and payers use separate scoped verification.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://127.0.0.1:3000

# Local demo email capture. No message leaves this computer.
EMAIL_TRANSPORT=mailpit
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
EMAIL_FROM=ScopeLedger <notifications@scopeledger.test>
EMAIL_DEMO_RECIPIENT=client@scopeledger.test
EMAIL_DEMO_PAYER_RECIPIENT=payer@scopeledger.test
EMAIL_MAILPIT_API=http://127.0.0.1:8025

# Local client/payer channel verification. Generate with npm run prepare:access-secret.
ACCESS_SESSION_SECRET=
ACCESS_CHALLENGE_DIR=../../.scopeledger-local/access
ACCESS_COOKIE_NAME=scopeledger_local_access

# Owned persistent local PostgreSQL demo service. Generate with npm run prepare:dev-db.
DEV_POSTGRES_USER=scopeledger_dev
DEV_POSTGRES_PASSWORD=
DEV_POSTGRES_DATABASE=scopeledger_dev
SCOPELEDGER_DATABASE_URL=
SCOPELEDGER_DATABASE_SCHEMA=scopeledger_dev
